// YF-S201 CALIBRATION CONSTANT: 450 pulses per liter
const float CALIBRATION_FACTOR = 450.0;  // pulses per liter for YF-S201

// Water flow sensor variables
volatile unsigned long pulseCount1 = 0;
volatile unsigned long pulseCount2 = 0;
float flowRate1 = 0.0;        // L/min
float flowRate2 = 0.0;        // L/min
float totalFlowRate = 0.0;    // L/min
float totalWater = 0.0;       // Total liters
